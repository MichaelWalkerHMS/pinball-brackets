# Supabase Configuration
# Copy this file to .env.local and fill in your values
# Get these from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Match Play Events API (optional - needed for Match Play integration)
# Get from: https://app.matchplay.events/settings/integrations
MATCHPLAY_API_TOKEN=your-matchplay-api-token-here

# Service key for seed script (optional - only needed for running npm run seed)
# This is the secret service_role key, NOT the publishable key
SUPABASE_SERVICE_KEY=sb_service_your-service-key-here

# E2E Test User Credentials (optional - only needed for running E2E tests)
# Each parallel worker needs its own user account to avoid session conflicts.
# Create users in Supabase Auth → Users, then add their credentials here.
# See .env.test for the actual test configuration.
#
# E2E_TEST_EMAIL_0=e2e-test-0@example.com
# E2E_TEST_PASSWORD_0=your-test-password
# E2E_TEST_USER_ID_0=uuid-from-supabase-auth
#
# E2E_TEST_EMAIL_1=e2e-test-1@example.com
# E2E_TEST_PASSWORD_1=your-test-password
# E2E_TEST_USER_ID_1=uuid-from-supabase-auth
# ... etc for workers 2, 3
