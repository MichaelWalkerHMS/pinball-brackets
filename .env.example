# Supabase Configuration
# Copy this file to .env.local and fill in your values
# Get these from: Supabase Dashboard → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Match Play Events API (optional - needed for Match Play integration)
# Get from: https://app.matchplay.events/settings/integrations
MATCHPLAY_API_TOKEN=your-matchplay-api-token-here

# Service key for seed script (optional - only needed for running npm run seed)
# This is the secret service_role key, NOT the publishable key
SUPABASE_SERVICE_KEY=sb_service_your-service-key-here
