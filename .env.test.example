# E2E Test Environment Variables
# Copy this file to .env.test and fill in your values

# Supabase Configuration (DEV project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Match Play Events API (can use real token or mock for unit tests)
MATCHPLAY_API_TOKEN=your-matchplay-api-token-here

# E2E Test User Credentials
# Each parallel worker needs its own user account to avoid session conflicts.
# Create users in Supabase Auth, then add their credentials here.
# Worker count is configured in playwright.config.ts (default: 4 locally, 1 in CI)

# Worker 0
E2E_TEST_EMAIL_0=e2e-test-0@yourdomain.com
E2E_TEST_PASSWORD_0=your-secure-test-password
E2E_TEST_USER_ID_0=uuid-of-test-user-0-from-supabase

# Worker 1
E2E_TEST_EMAIL_1=e2e-test-1@yourdomain.com
E2E_TEST_PASSWORD_1=your-secure-test-password
E2E_TEST_USER_ID_1=uuid-of-test-user-1-from-supabase

# Worker 2
E2E_TEST_EMAIL_2=e2e-test-2@yourdomain.com
E2E_TEST_PASSWORD_2=your-secure-test-password
E2E_TEST_USER_ID_2=uuid-of-test-user-2-from-supabase

# Worker 3
E2E_TEST_EMAIL_3=e2e-test-3@yourdomain.com
E2E_TEST_PASSWORD_3=your-secure-test-password
E2E_TEST_USER_ID_3=uuid-of-test-user-3-from-supabase

# E2E Admin User (for admin-only tests)
# This user must have is_admin=true in the profiles table
E2E_ADMIN_EMAIL=e2e-admin@yourdomain.com
E2E_ADMIN_PASSWORD=your-secure-test-password
E2E_ADMIN_USER_ID=uuid-of-admin-user-from-supabase
